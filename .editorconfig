root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

# GDScript and Godot scene/resource files are TAB-indented. Mixing spaces in a .tscn
# or a .gd will make diffs unreadable and can break paste from the GDD.
[*.gd]
indent_style = tab
indent_size = 4

[*.tres]
indent_style = space
indent_size = 2

[*.tscn]
indent_style = space
indent_size = 2

[*.gdshader]
indent_style = tab
indent_size = 4

[*.{md,json,yml,yaml,py,sh}]
indent_style = space
indent_size = 2
